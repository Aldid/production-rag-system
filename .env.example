# Production RAG System Environment Variables
APP_ENV=production
LOG_LEVEL=INFO

# API Server
HOST=0.0.0.0
PORT=8000

# Embedding Configuration
# Options: deterministic (for local testing/eval) or openai
EMBEDDING_PROVIDER=deterministic
EMBEDDING_DIM=384
OPENAI_API_KEY=

# Storage
VECTOR_STORE_BACKEND=memory
# For postgres / pgvector:
DATABASE_URL=postgresql://rag_user:rag_pass@localhost:5432/rag_db

# Security & Redaction
ENABLE_PII_REDACTION=true
ENABLE_INJECTION_DEFENSE=true
STRICT_CITATION_ENFORCEMENT=true
